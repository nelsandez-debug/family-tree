/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "family-tree",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	/**
	 * D1: people and parent/partner links
	 * Database "family-tree" already created; schema in migrations/ (idempotent).
	 * Apply the schema with: npm run db:migrate (or db:migrate:local)
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "family-tree",
			"database_id": "9f13b1e2-a465-4877-ab9d-e5eb80f28245",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * R2: profile photos
	 * Create with: npx wrangler r2 bucket create family-tree-photos
	 */
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "family-tree-photos"
		}
	],
	/**
	 * Durable Object migrations
	 * v1 came from the original workflows demo this repo started as. v2 removes
	 * that class, which the deployed Worker still depends on until it is deleted.
	 */
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["WorkflowStatusDO"] },
		{ "tag": "v2", "deleted_classes": ["WorkflowStatusDO"] }
	],
	"upload_source_maps": true
}
