/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "family-tree",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	/**
	 * D1: people and parent/partner links
	 * Create with: npx wrangler d1 create family-tree, then paste the database_id.
	 * Apply the schema with: npm run db:migrate (or db:migrate:local)
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "family-tree",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * R2: profile photos
	 * Create with: npx wrangler r2 bucket create family-tree-photos
	 */
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "family-tree-photos"
		}
	],
	"upload_source_maps": true
}
